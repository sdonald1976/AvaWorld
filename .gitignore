# Godot
.godot/
.mono/
*.translation

# Godot generates its own solution beside project.godot when you build from the editor.
# The real solution is AvaWorld.slnx at the repo root.
src/AvaWorld.Server/*.sln
src/AvaWorld.Server/*.csproj.user

# .NET
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/

# The world itself — runtime state, not source. Deleting it starts a new world.
world.json
world.json.saving
*.world.json

# The world's access token. Generated on first run and never source. This repo is public;
# committing it would publish the key to the world running on your machine.
.avaworld-token
/.vs
/.github
