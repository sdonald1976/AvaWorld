<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The channel the companion speaks on: protocol plus transport, plain .NET, no Godot.

    Kept out of the engine project on purpose. The brain renders nothing, so it has no business on
    the game-networking stack, and keeping this here means the whole wire can be tested without a
    display - including the handshake, which is exactly the sort of thing that only breaks in
    production otherwise.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaWorld.Simulation\AvaWorld.Simulation.csproj" />
  </ItemGroup>

</Project>
